<Window x:Class="FileLocationChecker.DiffViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileLocationChecker"
        xmlns:services="clr-namespace:FileLocationChecker.Services"
        mc:Ignorable="d"
        Title="文本文件差异对比 (Text File Diff Viewer)" Height="700" Width="1000"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- 背景颜色 Style 根据 Kind 触发器 -->
        <Style x:Key="DiffRowStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="2"/>
            <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E1E4E8"/>
            <Style.Triggers>
                <!-- 新增 (+): 淡绿 -->
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:DiffKind.Added}">
                    <Setter Property="Background" Value="#E6FFEC"/>
                    <Setter Property="Foreground" Value="#22863A"/>
                </DataTrigger>
                <!-- 删除 (-): 淡红 -->
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:DiffKind.Deleted}">
                    <Setter Property="Background" Value="#FFEEF0"/>
                    <Setter Property="Foreground" Value="#CB2431"/>
                </DataTrigger>
                <!-- 未变动: 白底黑字 -->
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:DiffKind.Unchanged}">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="Foreground" Value="#24292E"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题与路径信息 / Top Header File Info -->
        <Border Grid.Row="0" Background="#F6F8FA" BorderBrush="#D1D5DA" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 文件 A 路径 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="[A 源文件]" Foreground="#CB2431" FontWeight="Bold" Width="80"/>
                    <TextBlock x:Name="TxtPathA" Text="FilePathA" TextWrapping="NoWrap" Foreground="#333333"/>
                </StackPanel>

                <!-- 文件 B 路径 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <TextBlock Text="[B 目标文件]" Foreground="#22863A" FontWeight="Bold" Width="80"/>
                    <TextBlock x:Name="TxtPathB" Text="FilePathB" TextWrapping="NoWrap" Foreground="#333333"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 统计摘要 / Stats Summary Bar -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E1E4E8" BorderThickness="1" Padding="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtStats" Text="对比中..." FontWeight="Bold" FontSize="13" Foreground="#24292E"/>
            </StackPanel>
        </Border>

        <!-- 主 Diff 行显示区域 (ListView) -->
        <ListView x:Name="LvDiffLines" Grid.Row="2" ItemContainerStyle="{StaticResource DiffRowStyle}" 
                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="A 行" Width="50">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LineA}" TextAlignment="Right" Foreground="#999999"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="B 行" Width="50">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LineB}" TextAlignment="Right" Foreground="#999999"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header=" " Width="30">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Prefix}" FontWeight="Bold" TextAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="差异文本内容" Width="830">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" TextWrapping="NoWrap"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 底部提示与关闭 / Bottom Bar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="关闭" Width="85" Height="28" IsCancel="True" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
