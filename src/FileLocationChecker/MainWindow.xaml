<Window x:Class="FileLocationChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileLocationChecker"
        mc:Ignorable="d"
        Title="文件定位检查工具 (File Location Checker)" Height="650" Width="950"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 文件夹选择区域 / Folder Selection Area -->
        <GroupBox Header="1. 文件夹设置 (Folder Settings)" Grid.Row="0" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 文件夹 A -->
                <TextBlock Text="源文件夹 A:" VerticalAlignment="Center" Margin="0,0,10,10" Grid.Row="0" Grid.Column="0" FontWeight="Bold"/>
                <TextBox x:Name="TxtFolderA" Grid.Row="0" Grid.Column="1" Margin="0,0,10,10" VerticalContentAlignment="Center" Height="28" Padding="5,0"/>
                <Button x:Name="BtnBrowseA" Content="浏览 A..." Grid.Row="0" Grid.Column="2" Margin="0,0,0,10" Width="85" Height="28" Click="BtnBrowseA_Click"/>

                <!-- 文件夹 B -->
                <TextBlock Text="目标文件夹 B:" VerticalAlignment="Center" Margin="0,0,10,0" Grid.Row="1" Grid.Column="0" FontWeight="Bold"/>
                <TextBox x:Name="TxtFolderB" Grid.Row="1" Grid.Column="1" Margin="0,0,10,0" VerticalContentAlignment="Center" Height="28" Padding="5,0"/>
                <Button x:Name="BtnBrowseB" Content="浏览 B..." Grid.Row="1" Grid.Column="2" Width="85" Height="28" Click="BtnBrowseB_Click"/>
            </Grid>
        </GroupBox>

        <!-- 配置项区域 / Options Area -->
        <GroupBox Header="2. 配置选项 (Match Options)" Grid.Row="1" Margin="0,0,0,10" Padding="10">
            <WrapPanel Orientation="Horizontal">
                <CheckBox x:Name="ChkRecursiveA" Content="递归检查 A" IsChecked="False" Margin="0,0,25,0" VerticalAlignment="Center" ToolTip="勾选后将递归搜索文件夹 A 的所有子目录"/>
                <CheckBox x:Name="ChkCheckFileName" Content="检查文件名" IsChecked="True" Margin="0,0,25,0" VerticalAlignment="Center" ToolTip="匹配文件夹 A 与 B 中的文件名是否相同"/>
                <CheckBox x:Name="ChkCheckFileSize" Content="检查文件大小" IsChecked="True" Margin="0,0,5,0" VerticalAlignment="Center" ToolTip="匹配文件夹 A 与 B 中的文件字节大小"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,25,0" IsEnabled="{Binding ElementName=ChkCheckFileSize, Path=IsChecked}">
                    <TextBlock Text="容差:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#555555"/>
                    <Slider x:Name="SldSizeTolerance" Minimum="0" Maximum="100" Value="0" SmallChange="1" LargeChange="5" Width="85" VerticalAlignment="Center" ValueChanged="SldSizeTolerance_ValueChanged" ToolTip="设定文件大小对比的允许误差百分比 (0%-100%)"/>
                    <TextBlock x:Name="TxtToleranceValue" Text="0%" VerticalAlignment="Center" Margin="4,0,0,0" Width="35" Foreground="#007ACC" FontWeight="Bold"/>
                </StackPanel>
                <CheckBox x:Name="ChkExcludeAPath" Content="排除 A 路径" IsChecked="True" Margin="0,0,25,0" VerticalAlignment="Center" ToolTip="当 A 为 B 的子文件夹时，在 B 的扫描结果中自动排除 A 路径及其子目录下的文件自身"/>
            </WrapPanel>
        </GroupBox>

        <!-- 操作与控制按键 / Control Buttons Area -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnStart" Content="▶ 开始查找" Width="120" Height="32" Background="#007ACC" Foreground="White" FontWeight="Bold" Margin="0,0,15,0" Click="BtnStart_Click"/>
            <Button x:Name="BtnCancel" Content="⏹ 停止" Width="90" Height="32" IsEnabled="False" Click="BtnCancel_Click"/>
            <TextBlock x:Name="TxtSummary" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#555555" FontSize="13"/>
        </StackPanel>

        <!-- 匹配结果显示表格 / DataGrid Result Display -->
        <DataGrid x:Name="DgResults" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" 
                  CanUserSortColumns="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  SelectionMode="Single" MouseDoubleClick="DgResults_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="45"/>
                <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="160"/>
                <DataGridTextColumn Header="匹配状态" Binding="{Binding StatusDisplay}" Width="100"/>
                <DataGridTextColumn Header="A 大小" Binding="{Binding FormattedSizeA}" Width="85"/>
                <DataGridTextColumn Header="B 大小" Binding="{Binding FormattedSizeB}" Width="85"/>
                <DataGridTextColumn Header="文件夹 B 中定位位置 (TargetPath)" Binding="{Binding TargetPath}" Width="*"/>
                <DataGridTextColumn Header="文件夹 A 完整路径 (SourcePath)" Binding="{Binding SourcePath}" Width="250"/>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="比较差异 (A 与 B 文本对比)" Click="MenuCompareDiff_Click"/>
                    <Separator/>
                    <MenuItem Header="打开文件夹 A 所在位置" Click="MenuOpenFolderA_Click"/>
                    <MenuItem Header="打开文件夹 B 对应位置" Click="MenuOpenFolderB_Click"/>
                    <MenuItem Header="复制文件夹 B 路径" Click="MenuCopyTargetPath_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <!-- 底部状态栏 / Status Bar -->
        <StatusBar Grid.Row="4" Margin="0,10,0,0" Padding="5,2">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" Text="就绪" Width="400"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar x:Name="PbProgress" Width="200" Height="14" Visibility="Collapsed"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
